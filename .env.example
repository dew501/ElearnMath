# Salin file ini menjadi .env lalu isi dari Supabase: Project Settings > API Keys
# URL proyek TANPA akhiran /rest/v1
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Publishable key (sb_publishable_...) atau legacy anon key. JANGAN pakai secret/service_role key di sini.
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx
# Isi dengan alamat Vercel Anda setelah deploy (contoh: https://elearnmath.vercel.app)
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Opsional: kontak admin yang tampil di halaman login & lupa kata sandi (contoh: WA 0812-3456-7890 / tu@sekolah.sch.id)
NEXT_PUBLIC_ADMIN_CONTACT=

# ---- Hanya untuk server (JANGAN diberi awalan NEXT_PUBLIC_) ----
# API key Google AI Studio (gratis) untuk Koreksi AI: https://aistudio.google.com > Get API key
GEMINI_API_KEY=
# Opsional: urutan model Gemini (dipisah koma). Kosongkan untuk memakai urutan bawaan.
GEMINI_MODELS=
# Opsional: isi "aturan" untuk memakai mesin koreksi berbasis rubrik saja (tanpa AI)
KOREKSI_AI_MODE=
# Disarankan: secret key Supabase (Project Settings > API Keys > Secret keys) agar admin bisa membuat akun langsung aktif,
# menghapus akun, dan mengatur ulang kata sandi. Simpan hanya di server/hosting, jangan pernah di-commit.
SUPABASE_SECRET_KEY=
